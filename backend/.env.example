# ═══════════════════════════════════════════════════════════════
# ZapChat — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git.
# ═══════════════════════════════════════════════════════════════

# ─── BANCO DE DADOS ────────────────────────────────────────────
DB_HOST=localhost
DB_USER=seu_usuario_mysql
DB_PASS=sua_senha_mysql
DB_NAME=zapchat

# ─── AMBIENTE ──────────────────────────────────────────────────
# dev → CORS aberto para localhost
# producao → CORS restrito à FRONTEND_URL, webhook exige autenticação
AMBIENTE=dev

# ─── URLS ──────────────────────────────────────────────────────
# IMPORTANTE: sem barra no final, sem comentário inline na mesma linha
FRONTEND_URL=https://seu-dominio.com
BACKEND_URL=https://api.seu-dominio.com

# ─── SEGURANÇA ─────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere-uma-chave-forte-aqui

# ─── MERCADO PAGO ──────────────────────────────────────────────
# Use token de PRODUÇÃO ao subir o site (não o de teste)
MP_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
# Obtenha em: Mercado Pago → Integrações → Webhooks → Chave secreta
MP_WEBHOOK_SECRET=sua-chave-secreta-do-webhook

# IDs dos planos criados via POST /pagamentos/criar-plano-mp
# Execute a rota 1x para cada combinação e cole os IDs retornados abaixo
MP_PLAN_ID_PRO_MENSAL=id-retornado-pelo-mp
MP_PLAN_ID_PRO_ANUAL=id-retornado-pelo-mp
MP_PLAN_ID_BUSINESS_MENSAL=id-retornado-pelo-mp
MP_PLAN_ID_BUSINESS_ANUAL=id-retornado-pelo-mp

# ─── EMAIL (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_sua_chave_aqui
# Substitua pelo seu domínio verificado no Resend
EMAIL_REMETENTE=noreply@seu-dominio.com

# ─── OPENAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-sua-chave-aqui

# ─── EVOLUTION API (WhatsApp) ──────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-da-evolution
